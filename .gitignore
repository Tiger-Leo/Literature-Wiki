# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Raw PDFs (optional — commit or not depending on size and licensing)
raw_pdfs/*.pdf

# Large assets
raw_markdown/assets/*.png
raw_markdown/assets/*.jpg
raw_markdown/assets/*.jpeg

# Exports (regenerated by script — optionally exclude)
# exports/

# Agent task temp files
agent_tasks/*/
!agent_tasks/.gitkeep

# Frontend (web/) — Next.js
web/node_modules/
web/.next/
web/.env*
web/*.tsbuildinfo

# RAG backend (rag/) — runtime artifacts
rag/index/
rag/threads.db
rag/__pycache__/
**/__pycache__/

# Generated search index
exports/wiki.json
exports/*-wiki.json
web/public/wiki-index.json

# Local env (canonical reference is .env.example)
.env

# Browser-test artifacts
.playwright-cli/
.playwright-mcp/

# deterministic build/serve script logs
.build_and_serve*.log
