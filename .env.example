# ============================================================================
# literature-wiki — canonical environment reference
# ============================================================================
# Copy to `.env` and edit. `.env` is git-ignored. The Makefile and
# scripts/serve.sh auto-load `.env`; docker-compose reads it via `env_file`.
# Every var is optional — sensible defaults live in rag/config.py and
# web/src/lib/api.ts. Only set what you need to override.
#
# Var names here are the single source of truth, matched 1:1 against
# rag/config.py (RAG_*) and the frontend (NEXT_PUBLIC_*).
# ============================================================================


# --- Frontend (Next.js, web/) ----------------------------------------------
# Public site chrome. These are inlined at build time (NEXT_PUBLIC_* are
# baked into the bundle), so re-run `pnpm build` after changing them.
NEXT_PUBLIC_SITE_TITLE="Literature Wiki"
NEXT_PUBLIC_SITE_DESCRIPTION="A Wikipedia-style synthesis of a research literature."
NEXT_PUBLIC_SITE_GREETING="Ask anything about the literature."
NEXT_PUBLIC_SITE_PLACEHOLDER="e.g. What is the debate about X?"

# How the browser reaches the API. Leave NEXT_PUBLIC_API_URL UNSET to use the
# runtime-host pattern (api.ts derives the API base from window.location host
# + NEXT_PUBLIC_BACKEND_PORT) — this is what makes the build portable across
# localhost / LAN / VPN without baking an IP. Set NEXT_PUBLIC_API_URL only to
# force an explicit, fixed API origin (e.g. behind a reverse proxy or docker).
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_PORT=8000

# Wiki source directory the export step reads (relative to repo root).
WIKI_DIR=wiki


# --- Chat backend (rag/) — AGENTIC SEARCH ONLY -----------------------------
# The Chat surface answers ONLY by agentic filesystem navigation: the generation
# model drives sandboxed list_dir/glob/grep/read_file tools over wiki/ + raw_markdown/.
# There is NO embedding index, vector store, BM25, or graph index — and NO index
# build step. The only provider needed is a generation (chat) model.

# Point the backend at a wiki repo living elsewhere. Defaults to this repo
# root (rag/'s parent), so usually leave unset.
# RAG_WIKI_ROOT=/abs/path/to/your/wiki-repo

# One-line subject description; injected into the agentic system prompt.
RAG_DOMAIN_DESC="a curated research-literature wiki of Wikipedia-style synthesis pages"

# CORS. "*" is fine for local dev; restrict before exposing publicly, e.g.
# RAG_CORS_ORIGINS=https://wiki.example.com,http://localhost:3000
RAG_CORS_ORIGINS=*

# Server bind. RAG_HOST defaults to 127.0.0.1 when running `python -m rag.server`;
# use 0.0.0.0 to expose on LAN/VPN. The Makefile `api` target binds 0.0.0.0.
RAG_HOST=0.0.0.0
RAG_PORT=8000


# --- Generation: ONE OpenAI-compatible endpoint ----------------------------
# The backend talks to a single endpoint over the OpenAI chat-completions
# protocol. `pip install openai` (already in rag/requirements.txt). Config
# precedence (first non-empty wins): RAG_* env vars > repo-root .env friendly
# keys (base_url/api_key/model) > the local-Ollama defaults baked into rag/config.py.
#
# (A) LOCAL via Ollama — Ollama serves the OpenAI protocol at /v1, so just point
#     the base URL there. This is the zero-config default (no need to set these).
#     Pull the model first:  ollama pull <gen-model>
# RAG_OPENAI_BASE_URL=http://localhost:11434/v1
# RAG_OPENAI_API_KEY=ollama                 # any non-empty string; Ollama ignores it
# RAG_GEN_MODEL=qwen3.6:35b-mlx
#
# (B) HOSTED — any OpenAI-compatible endpoint (OpenAI, DeepSeek, vLLM, OpenRouter, …).
# RAG_OPENAI_BASE_URL=https://api.deepseek.com/v1
# RAG_OPENAI_API_KEY=sk-...
# RAG_GEN_MODEL=deepseek-chat
#
# Friendly alternative — lower-case keys in this same .env (RAG_* still wins):
#   base_url=https://api.deepseek.com/v1
#   api_key=sk-...
#   model=deepseek-chat


# --- Agentic loop tuning (optional) ----------------------------------------
# RAG_AGENT_MAX_STEPS=12                   # max tool-call turns before forcing an answer
# RAG_AGENT_TOOL_BACKEND=react             # react (default) | native | auto
# RAG_AGENT_GREP_MAX=40                    # default grep hit cap
# RAG_AGENT_READ_LIMIT=400                 # default read_file line window
